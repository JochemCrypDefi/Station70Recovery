# NEVER commit recovery material. `*.json` covers backups, keystores and the
# KMS import parameters in one line -- there is nothing in this project that
# needs to be a committed .json.
*.json
*.pem
*.der
*.key
out/
wheels/

# AWS KMS export. The wrapped blob is ciphertext and the import token is
# public, but neither belongs in a repo, and *.der/*.bin would catch a
# stray unwrapped key.
*.bin
Import_Parameters_*/
import-parameters*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
